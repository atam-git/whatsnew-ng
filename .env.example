# Backend API (NestJS). Browser calls go through the Next rewrite at /api/*,
# server components can use this directly.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public hostname that serves media (for next/image remotePatterns)
NEXT_PUBLIC_MEDIA_HOST=media.whatsnew.ng

# Public site URL (canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Error monitoring (optional — the SDK is inert if unset)
NEXT_PUBLIC_SENTRY_DSN=
# Only needed in CI to upload source maps:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

